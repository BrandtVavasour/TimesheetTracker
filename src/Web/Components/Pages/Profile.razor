@page "/profile"
@rendermode InteractiveServer
@using FluentValidation
@using TimesheetTracker.Web.Validation
@inject ITimesheetData Data
@inject IToastService Toast
@inject ILogger<Profile> Logger
@inject IAccountInfo Account
@inject IValidator<ProfileForm> Validator
@inject IAccountExport ExportSvc
@inject IJSRuntime Js

<PageHead Title="Profile" Subtitle="Your details and sign-in methods." />

@if (_user is null)
{
    <div style="margin-top:22px;color:var(--text-mute);">Loading…</div>
}
else
{
    <NavigationLock ConfirmExternalNavigation="@IsDirty" OnBeforeInternalNavigation="GuardNavAsync" />
    @if (_validated) { _validation = Validator.Validate(_form); }

    <div style="max-width:680px;display:flex;flex-direction:column;gap:16px;padding:22px 0 40px;">
        <Card Title="Profile" Desc="Shown in the app header and on every export.">
            <div style="display:flex;gap:18px;align-items:center;margin-bottom:18px;">
                <span style="width:60px;height:60px;border-radius:16px;background:var(--accent);color:#fff;display:grid;place-items:center;font-size:24px;font-weight:700;">@Initials</span>
                <div>
                    <div style="font-size:18px;font-weight:700;">@_user.DisplayName</div>
                    <div style="font-size:13px;color:var(--text-soft);">@_user.Email</div>
                </div>
            </div>
            <div class="ts-2col" style="display:grid;grid-template-columns:1fr 220px;gap:16px;align-items:start;">
                <Field Label="Display name">
                    <input class="input" @bind="_form.DisplayName" @bind:event="oninput"
                           style="@(FieldError(nameof(ProfileForm.DisplayName)) is not null ? "border-color:var(--danger);" : "")" />
                    @if (FieldError(nameof(ProfileForm.DisplayName)) is { } err)
                    {
                        <span style="font-size:12px;color:var(--danger);">@err</span>
                    }
                </Field>
                <Field Label="Default holiday state" Hint="Used by jobs without an override.">
                    <select class="input" value="@_form.DefaultState" @onchange="@(e => _form.DefaultState = Enum.Parse<AustralianState>(e.Value!.ToString()!))">
                        @foreach (var s in Enum.GetValues<AustralianState>())
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </Field>
            </div>
            <div style="margin-top:16px;padding-top:16px;border-top:1px solid var(--line);">
                <label style="display:flex;align-items:flex-start;gap:11px;cursor:pointer;">
                    <input type="checkbox" data-testid="include-all-days" checked="@_form.ExportIncludeAllDays"
                           @onchange="@(e => _form.ExportIncludeAllDays = (bool)e.Value!)" style="margin-top:2px;" />
                    <span>
                        <span style="display:block;font-size:13.5px;font-weight:600;">Include every day in exports</span>
                        <span style="display:block;font-size:12px;color:var(--text-soft);">Show all calendar days in the export preview, Excel and PDF — even days with no times logged.</span>
                    </span>
                </label>
            </div>
            <div style="display:flex;justify-content:flex-end;margin-top:16px;">
                <Btn Variant="primary" Icon="check" Disabled="@(!IsDirty)" OnClick="Save">Save profile</Btn>
            </div>
        </Card>

        <Card Title="Sign-in methods" Desc="Local account plus optional Google sign-in.">
            <div style="display:flex;flex-direction:column;gap:10px;">
                <div style="display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:var(--r-md);border:1px solid var(--line);flex-wrap:wrap;">
                    <svg width="22" height="22" viewBox="0 0 48 48" style="flex:none;display:block;">
                        <path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-2.7-.4-3.9H24v7.1h12.1c-.2 1.8-1.6 4.6-4.5 6.5l-.04.3 6.6 5.1.5.05c4.2-3.9 6.6-9.6 6.6-15.2Z"/>
                        <path fill="#34A853" d="M24 46c5.9 0 10.9-2 14.5-5.3l-6.9-5.4c-1.9 1.3-4.3 2.2-7.6 2.2-5.8 0-10.7-3.8-12.4-9.1l-.3.02-6.9 5.3-.1.3C7.8 41 15.3 46 24 46Z"/>
                        <path fill="#FBBC05" d="M11.6 28.4c-.5-1.3-.7-2.7-.7-4.4s.3-3.1.7-4.4l-.01-.3-7-5.4-.2.1C2.9 17.1 2 20.4 2 24s.9 6.9 2.5 10l7.1-5.6Z"/>
                        <path fill="#EB4335" d="M24 9.5c4.1 0 6.9 1.8 8.5 3.3l6.2-6C34.9 3.3 29.9 1 24 1 15.3 1 7.8 6 4.5 14l7.1 5.6C13.3 13.3 18.2 9.5 24 9.5Z"/>
                    </svg>
                    <div style="flex:1;">
                        <div style="font-size:13.5px;font-weight:600;">Google</div>
                        <div style="font-size:12px;color:var(--text-soft);">@_user.Email</div>
                    </div>
                    @if (_methods?.HasGoogle == true)
                    {
                        <Badge Tone="accent">Connected</Badge>
                    }
                    else
                    {
                        <span style="font-size:12.5px;color:var(--text-mute);">Not connected</span>
                    }
                </div>
                <div style="display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:var(--r-md);border:1px solid var(--line);flex-wrap:wrap;">
                    <span style="width:22px;height:22px;display:grid;place-items:center;color:var(--text-soft);"><Icon Name="user" Size="20" /></span>
                    <div style="flex:1;">
                        <div style="font-size:13.5px;font-weight:600;">Email &amp; password</div>
                        <div style="font-size:12px;color:var(--text-soft);">
                            @(_methods?.HasPassword == true ? "Sign in with your email and password." : "No password set — you sign in with Google.")
                        </div>
                    </div>
                    @if (_methods?.HasPassword == true)
                    {
                        <Btn Size="sm" Variant="outline" Href="Account/Manage/ChangePassword">Change password</Btn>
                    }
                </div>
            </div>
        </Card>

        <Card Title="Your data" Desc="Download a copy of everything in your account.">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;">
                <div style="font-size:13px;color:var(--text-soft);max-width:430px;">
                    A ZIP with an Excel <em>and</em> a JSON file for every job (archived included) — all your time
                    entries — plus an <span class="mono">account.json</span> summary of your profile.
                </div>
                <Btn Variant="outline" Icon="download" OnClick="ExportAll">Export all data (.zip)</Btn>
            </div>
        </Card>

        <div style="border:1px solid var(--danger-tint);border-radius:var(--r-lg);background:var(--surface);box-shadow:var(--sh-1);overflow:hidden;">
            <div style="padding:18px 20px;border-bottom:1px solid var(--line);background:var(--danger-tint);">
                <div style="font-size:15px;font-weight:700;color:var(--danger);">Danger zone</div>
            </div>
            <div style="padding:18px 20px;display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;">
                <div style="font-size:13px;color:var(--text-soft);max-width:430px;">
                    Permanently delete your account and <strong>all</strong> jobs, time entries and project codes.
                    This cannot be undone — export your data first if you want a copy.
                </div>
                <Btn Variant="danger" Icon="trash" Href="Account/Manage/DeleteAccount">Delete account</Btn>
            </div>
        </div>
    </div>
}

@code {
    private AppUser? _user;
    private AccountMethods? _methods;
    private ProfileForm _form = new();

    private FormSnapshot<ProfileForm>? _snapshot;
    private FluentValidation.Results.ValidationResult? _validation;
    private bool _validated;

    private bool IsDirty => _snapshot is not null && _snapshot.IsDirty(_form);

    private string? FieldError(string property) =>
        _validated ? _validation?.Errors.FirstOrDefault(e => e.PropertyName == property)?.ErrorMessage : null;

    private string Initials => _user is null ? "" : string.Concat(
        _user.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0]));

    protected override async Task OnInitializedAsync()
    {
        _user = await Data.CurrentUserAsync();
        _methods = await Account.GetMethodsAsync();
        _form = new ProfileForm
        {
            DisplayName = _user.DisplayName,
            DefaultState = _user.DefaultState,
            ExportIncludeAllDays = _user.ExportIncludeAllDays,
        };
        _snapshot = new(_form);
    }

    private async Task<bool> ConfirmDiscardAsync() =>
        await Js.InvokeAsync<bool>("confirm", "You have unsaved changes. Discard them?");

    private async Task GuardNavAsync(LocationChangingContext context)
    {
        if (IsDirty && !await ConfirmDiscardAsync())
        {
            context.PreventNavigation();
        }
    }

    private async Task ExportAll() =>
        await Toast.RunAsync(Logger,
            async () =>
            {
                var bytes = await ExportSvc.BuildZipAsync();
                await Js.InvokeVoidAsync("tsDownload",
                    $"timesheet-data-{Data.Today:yyyy-MM-dd}.zip", Convert.ToBase64String(bytes), "application/zip");
            },
            "Your data export downloaded", "Couldn't build your export — please try again.", "export account");

    private async Task Save()
    {
        _validated = true;
        _validation = Validator.Validate(_form);
        if (!_validation.IsValid)
        {
            Toast.Error("Please fix the highlighted fields.");
            return;
        }

        var ok = await Toast.RunAsync(Logger,
            async () =>
            {
                await Data.UpdateUserAsync(_form.DisplayName, _form.DefaultState, _form.ExportIncludeAllDays);
                _user = await Data.CurrentUserAsync();
            },
            "Profile updated", "Couldn't update your profile — please try again.", "save profile");
        if (ok) _snapshot!.Reset(_form);
    }
}
