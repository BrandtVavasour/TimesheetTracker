<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Timesheet Tracker</title>
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Versioned("app.css")" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>
    <script src="@Versioned("ts.js")" nonce="@Nonce"></script>
    <script src="_framework/blazor.web.js" nonce="@Nonce"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [Inject] private IAssetVersion AssetVer { get; set; } = default!;

    private string Nonce => HttpContext?.GetNonce() ?? "";

    // Content-hash cache buster: browsers cached ts.js/app.css and kept running
    // stale copies after deploys (e.g. the clipboard fix never reached them).
    private string Versioned(string asset) => $"{asset}?v={AssetVer.For(asset)}";
}
