@inject ITimeCalculationService Calc
@inject IJSRuntime JS

@if (Open && _e is not null)
{
    <div @onclick="OnClose" style="position:fixed;inset:0;z-index:200;background:rgba(22,27,26,0.42);backdrop-filter:blur(2px);
         display:flex;align-items:flex-start;justify-content:center;padding:7vh 20px 40px;animation:fadeIn .14s ease;">
        <div @onclick:stopPropagation="true" style="width:560px;max-width:100%;max-height:86vh;display:flex;flex-direction:column;
             background:var(--surface);border-radius:var(--r-lg);box-shadow:var(--sh-3);border:1px solid var(--line);
             animation:popIn .18s cubic-bezier(.2,.8,.3,1);overflow:hidden;">

            <div style="display:flex;align-items:flex-start;justify-content:space-between;padding:18px 20px 14px;border-bottom:1px solid var(--line);">
                <div>
                    <div style="font-size:16.5px;font-weight:700;letter-spacing:-0.01em;">@(IsNew ? "Add entry" : "Edit entry")</div>
                    <div style="font-size:13px;color:var(--text-soft);margin-top:2px;">@Job.Name · @CalendarFormat.DayLong(_e.WorkDate)</div>
                </div>
                <button class="ts-iconbtn focusable" @onclick="OnClose" title="Close"
                        style="width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;border-radius:var(--r-sm);
                               border:1px solid transparent;background:transparent;color:var(--text-soft);cursor:pointer;">
                    <Icon Name="x" Size="17" />
                </button>
            </div>

            <div style="padding:18px 20px;overflow-y:auto;display:flex;flex-direction:column;gap:16px;">
                <div style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
                    <label style="display:flex;flex-direction:column;gap:6px;">
                        <span style="font-size:12.5px;font-weight:600;color:var(--text-soft);">Start</span>
                        <input type="time" class="mono focusable" value="@(_start?.ToString("HH:mm") ?? "")"
                               @onchange="@(e => OnTime(true, e.Value?.ToString()))" style="@TimeInputStyle" />
                    </label>
                    <div style="padding-bottom:9px;color:var(--text-mute);"><Icon Name="arrowR" Size="16" /></div>
                    <label style="display:flex;flex-direction:column;gap:6px;">
                        <span style="font-size:12.5px;font-weight:600;color:var(--text-soft);">End</span>
                        <input type="time" class="mono focusable" value="@(_end?.ToString("HH:mm") ?? "")"
                               @onchange="@(e => OnTime(false, e.Value?.ToString()))" style="@TimeInputStyle" />
                    </label>
                    <label style="display:flex;align-items:center;gap:8px;padding-bottom:9px;margin-left:4px;cursor:pointer;">
                        <input type="checkbox" checked="@_e.EndsNextDay" @onchange="@(e => _e.EndsNextDay = (bool)e.Value!)" />
                        <span style="font-size:13px;font-weight:600;color:@(_e.EndsNextDay ? "var(--accent-text)" : "var(--text-soft)");">Ends next day</span>
                    </label>
                    <label style="display:flex;align-items:center;gap:8px;padding-bottom:9px;cursor:pointer;">
                        <input type="checkbox" data-testid="wfh" checked="@_e.IsWorkFromHome" @onchange="@(e => _e.IsWorkFromHome = (bool)e.Value!)" />
                        <span style="font-size:13px;font-weight:600;color:@(_e.IsWorkFromHome ? "var(--accent-text)" : "var(--text-soft)");">Worked from home</span>
                    </label>
                </div>

                @if (SuggestsNextDay() && _e.EndsNextDay)
                {
                    <div style="font-size:12.5px;color:var(--holiday);display:flex;gap:6px;align-items:center;margin-top:-6px;">
                        <Icon Name="info" Size="14" /> End is on or before start — crossing midnight assumed.
                    </div>
                }

                <label style="display:flex;flex-direction:column;gap:6px;">
                    <span style="font-size:12.5px;font-weight:600;color:var(--text-soft);">Unpaid break</span>
                    <div style="display:flex;gap:8px;align-items:center;">
                        <input type="number" min="0" step="5" value="@_e.BreakMinutes" class="mono focusable"
                               @onchange="@(e => _e.BreakMinutes = Math.Max(0, int.TryParse(e.Value?.ToString(), out var v) ? v : 0))"
                               style="@(InputStyle("width:92px;"))" />
                        <span style="font-size:13px;color:var(--text-mute);">min</span>
                        <div style="display:flex;gap:6px;margin-left:6px;">
                            @foreach (var b in new[] { 0, 30, 45, 60 })
                            {
                                <button class="mono focusable" @onclick="@(() => _e.BreakMinutes = b)"
                                        style="padding:5px 10px;font-size:12.5px;font-weight:600;border-radius:var(--r-xs);cursor:pointer;
                                               border:1px solid var(--line-strong);
                                               background:@(_e.BreakMinutes == b ? "var(--accent-tint)" : "var(--surface)");
                                               color:@(_e.BreakMinutes == b ? "var(--accent-text)" : "var(--text-soft)");">@b</button>
                            }
                        </div>
                    </div>
                </label>

                @if (Job.ProjectCodes.Count > 0)
                {
                    <label style="display:flex;flex-direction:column;gap:6px;">
                        <span style="font-size:12.5px;font-weight:600;color:var(--text-soft);">Project code</span>
                        <select class="focusable" value="@(_e.ProjectCodeId?.ToString() ?? "")"
                                @onchange="OnProjectChange" style="@(InputStyle("width:300px;cursor:pointer;"))">
                            <option value="">— Untagged —</option>
                            @foreach (var c in Job.ProjectCodes.Where(c => c.IsActive || c.Id == _e.ProjectCodeId).OrderBy(c => c.DisplayOrder))
                            {
                                <option value="@c.Id">@OptionLabel(c)</option>
                            }
                        </select>
                    </label>
                }

                <label style="display:flex;flex-direction:column;gap:6px;">
                    <span style="font-size:12.5px;font-weight:600;color:var(--text-soft);">Notes</span>
                    <textarea rows="2" placeholder="What did you work on?" class="focusable"
                              @onchange="@(e => _e.Notes = e.Value?.ToString())"
                              style="@(InputStyle("height:auto;padding:8px 10px;resize:vertical;line-height:1.45;"))">@_e.Notes</textarea>
                </label>

                @if (_start is null || _end is null)
                {
                    <div style="padding:12px 14px;border-radius:var(--r-md);background:var(--surface-2);border:1px dashed var(--line-strong);
                                font-size:13px;color:var(--text-soft);display:flex;align-items:center;gap:8px;">
                        <Icon Name="info" Size="15" /> Enter start and end times to see the hours.
                    </div>
                }
                else
                {
                    <div style="display:flex;align-items:center;gap:18px;padding:12px 14px;border-radius:var(--r-md);
                                background:@(Valid ? "var(--accent-tint)" : "var(--danger-tint)");border:1px solid @(Valid ? "var(--accent-tintb)" : "transparent");">
                        <div>
                            <div style="font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:@(Valid ? "var(--accent-text)" : "var(--danger)");">Decimal hours</div>
                            <div class="mono" style="font-size:26px;font-weight:700;line-height:1.1;color:@(Valid ? "var(--accent-text)" : "var(--danger)");">
                                @(Valid ? HoursFormat.Decimal(Dur, Job.DecimalPlaces) : "—")
                            </div>
                        </div>
                        <div style="width:1px;height:34px;background:@(Valid ? "var(--accent-tintb)" : "#0001");"></div>
                        <div>
                            <div style="font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:var(--text-soft);">Duration</div>
                            <div class="mono" style="font-size:26px;font-weight:700;line-height:1.1;color:@(Valid ? "var(--text)" : "var(--danger)");">
                                @(Valid ? HoursFormat.Hmm(Dur) : "invalid")
                            </div>
                        </div>
                        <div style="margin-left:auto;font-size:12px;color:var(--text-soft);max-width:150px;text-align:right;">
                            @(Valid ? $"at {Job.DecimalPlaces} dp precision" : "End must be after start (after break).")
                        </div>
                    </div>
                }
            </div>

            <div style="display:flex;gap:8px;justify-content:flex-end;padding:14px 20px;border-top:1px solid var(--line);background:var(--surface-2);">
                @if (!IsNew)
                {
                    <Btn Variant="danger" Icon="trash" OnClick="Delete" Style="margin-right:auto;">Delete</Btn>
                }
                <Btn OnClick="OnClose">Cancel</Btn>
                <Btn Variant="primary" Icon="check" Disabled="@(!Valid)" OnClick="Save">Save entry</Btn>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public TimeEntry? Draft { get; set; }
    [Parameter] public bool IsNew { get; set; }
    [Parameter, EditorRequired] public Job Job { get; set; } = null!;
    /// <summary>Prefill for a new entry's start time (job default / previous entry); null = leave empty.</summary>
    [Parameter] public TimeOnly? InitialStart { get; set; }
    /// <summary>Prefill for a new entry's end time (job default); null = leave empty.</summary>
    [Parameter] public TimeOnly? InitialEnd { get; set; }
    [Parameter] public EventCallback<TimeEntry> OnSaveEntry { get; set; }
    [Parameter] public EventCallback<Guid> OnDeleteEntry { get; set; }
    [Parameter] public EventCallback OnCloseEditor { get; set; }

    private TimeEntry? _e;
    private TimeEntry? _lastDraft;
    private FormSnapshot<TimeEntry>? _snapshot;   // baseline for the discard-on-close guard
    // Times are tracked separately from the entity so they can start empty —
    // an unset time is "fill me in", not 00:00. Synced into _e once both exist.
    private TimeOnly? _start;
    private TimeOnly? _end;

    private int Dur => _e is null || _start is null || _end is null ? 0 : Calc.DurationMinutes(_e);
    private bool Valid => Dur > 0;
    private bool IsDirty => _e is not null && _snapshot is not null && _snapshot.IsDirty(_e);

    // Wide enough for 12-hour locales (e.g. "12:30 pm" + the picker icon in
    // en-AU Chrome) — 108px clipped the AM/PM.
    private const string TimeInputStyle =
        "height:36px;width:140px;min-width:140px;padding:0 10px;border-radius:var(--r-sm);border:1px solid var(--line-strong);background:var(--surface);color:var(--text);font-size:14px;outline:none;";

    private static string InputStyle(string extra) =>
        $"height:36px;width:100%;padding:0 10px;border-radius:var(--r-sm);border:1px solid var(--line-strong);background:var(--surface);color:var(--text);font-size:14px;outline:none;{extra}";

    protected override void OnParametersSet()
    {
        // Re-clone whenever a new draft is handed in.
        if (!ReferenceEquals(_lastDraft, Draft))
        {
            _lastDraft = Draft;
            _e = Draft is null ? null : Clone(Draft);
            if (_e is not null)
            {
                _start = IsNew ? InitialStart : _e.StartTime;
                _end = IsNew ? InitialEnd : _e.EndTime;
                SyncTimes();
                // Baseline AFTER prefilling, so opening with defaults isn't "dirty".
                _snapshot = new(_e);
            }
        }
    }

    private static TimeEntry Clone(TimeEntry s) => new()
    {
        Id = s.Id, JobId = s.JobId, WorkDate = s.WorkDate, StartTime = s.StartTime, EndTime = s.EndTime,
        EndsNextDay = s.EndsNextDay, BreakMinutes = s.BreakMinutes, IsWorkFromHome = s.IsWorkFromHome,
        Notes = s.Notes, ProjectCodeId = s.ProjectCodeId
    };

    private async Task OnClose()
    {
        // Confirm before discarding unsaved edits (Cancel / X / backdrop click).
        if (IsDirty && !await JS.InvokeAsync<bool>("confirm", "Discard your changes to this entry?")) return;
        await OnCloseEditor.InvokeAsync();
    }

    private static string OptionLabel(ProjectCode c)
    {
        var label = c.Code;
        if (!string.IsNullOrEmpty(c.Description)) label += " · " + c.Description;
        if (!c.IsActive) label += " (inactive)";
        return label;
    }

    private bool SuggestsNextDay() => _start.HasValue && _end.HasValue && _end <= _start;

    private void OnTime(bool isStart, string? value)
    {
        TimeOnly? t = TimeOnly.TryParse(value, out var parsed) ? parsed : null;
        if (isStart) _start = t; else _end = t;
        SyncTimes();
    }

    /// <summary>Write the chosen times into the entity and auto-suggest crossing midnight.</summary>
    private void SyncTimes()
    {
        if (_e is null || _start is null || _end is null) return;
        _e.StartTime = _start.Value;
        _e.EndTime = _end.Value;
        if (_e.EndTime < _e.StartTime) _e.EndsNextDay = true;
        else if (_e.EndTime > _e.StartTime) _e.EndsNextDay = false;
    }

    private void OnProjectChange(ChangeEventArgs e)
    {
        if (_e is null) return;
        _e.ProjectCodeId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
    }

    private async Task Save()
    {
        if (_e is null || !Valid) return;
        await OnSaveEntry.InvokeAsync(_e);
        await OnCloseEditor.InvokeAsync();
    }

    private async Task Delete()
    {
        if (_e is null) return;
        await OnDeleteEntry.InvokeAsync(_e.Id);
        await OnCloseEditor.InvokeAsync();
    }
}
