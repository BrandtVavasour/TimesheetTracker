@inject IJSRuntime JS

<button @onclick="Copy" title="@($"Copy {Name}: {Value}")" class="copyfield focusable"
        style="display:inline-flex;flex-direction:column;line-height:1.2;padding:5px 11px;cursor:pointer;text-align:left;border-radius:var(--r-sm);
               background:@(_done ? "var(--accent-tint)" : "var(--surface)");border:1px solid @(_done ? "var(--accent)" : "var(--line)");transition:background .14s, border-color .14s;">
    <span style="font-size:10.5px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;color:var(--text-mute);display:flex;align-items:center;gap:4px;">
        @Name
        <span style="color:@(_done ? "var(--accent)" : "var(--text-mute)");display:inline-flex;@(_done ? "animation:flashCopied .4s ease;" : "")">
            <Icon Name="@(_done ? "check" : "copy")" Size="10.5" Stroke="2.2" />
        </span>
    </span>
    <span class="mono" style="font-size:13px;font-weight:600;color:@(_done ? "var(--accent-text)" : "var(--text)");">@Value</span>
</button>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";

    private bool _done;

    private async Task Copy()
    {
        await JS.InvokeVoidAsync("tsCopy", Value);
        _done = true;
        StateHasChanged();
        await Task.Delay(1100);
        _done = false;
        StateHasChanged();
    }
}
