@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject ITimesheetData Data
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization

<div style="min-height:100%;display:flex;flex-direction:column;">
    <header style="position:sticky;top:0;z-index:100;background:rgba(255,255,255,0.82);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);">
        <div style="max-width:1220px;margin:0 auto;height:58px;padding:0 24px;display:flex;align-items:center;gap:18px;">
            <div style="display:flex;align-items:center;gap:9px;flex:none;">
                <span style="width:30px;height:30px;border-radius:8px;background:var(--accent);color:#fff;display:grid;place-items:center;">
                    <Icon Name="clock" Size="18" Stroke="2" />
                </span>
                <span class="ts-hide-narrow" style="font-size:15.5px;font-weight:700;letter-spacing:-0.02em;">Timesheet</span>
            </div>
            <nav style="display:flex;gap:2px;margin-left:10px;overflow-x:auto;">
                @foreach (var n in Items)
                {
                    var on = IsActive(n.Href);
                    <a href="@n.Href" class="navitem focusable"
                       style="display:flex;align-items:center;gap:7px;padding:8px 13px;border-radius:var(--r-sm);cursor:pointer;text-decoration:none;
                              background:@(on ? "var(--accent-tint)" : "transparent");color:@(on ? "var(--accent-text)" : "var(--text-soft)");
                              font-size:13.5px;font-weight:600;white-space:nowrap;">
                        <Icon Name="@n.Icon" Size="16" /><span class="ts-hide-narrow">@n.Label</span>
                    </a>
                }
                @* Admins only — the route itself is also [Authorize(Roles=Admin)] gated. *@
                <AuthorizeView Roles="Admin">
                    @{ var adminOn = IsActive("admin"); }
                    <a href="admin" class="navitem focusable"
                       style="display:flex;align-items:center;gap:7px;padding:8px 13px;border-radius:var(--r-sm);cursor:pointer;text-decoration:none;
                              background:@(adminOn ? "var(--accent-tint)" : "transparent");color:@(adminOn ? "var(--accent-text)" : "var(--text-soft)");
                              font-size:13.5px;font-weight:600;white-space:nowrap;">
                        <Icon Name="sliders" Size="16" /><span class="ts-hide-narrow">Admin</span>
                    </a>
                </AuthorizeView>
            </nav>
            <div style="margin-left:auto;display:flex;align-items:center;gap:8px;flex:none;">
                <a href="profile" class="focusable" title="@_displayName"
                   style="width:34px;height:34px;border-radius:99px;border:1px solid var(--line-strong);background:var(--accent);color:#fff;
                          font-weight:700;font-size:13px;display:grid;place-items:center;text-decoration:none;">
                    @Initials
                </a>
                <form action="Account/Logout" method="post" style="display:inline-flex;">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="" />
                    <button type="submit" class="ts-iconbtn focusable" title="Sign out"
                            style="width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;border-radius:var(--r-sm);border:1px solid transparent;background:transparent;color:var(--text-soft);cursor:pointer;">
                        <Icon Name="logout" Size="17" />
                    </button>
                </form>
            </div>
        </div>
    </header>

    @if (_showVerifyBanner)
    {
        <div style="background:var(--holiday-tint);border-bottom:1px solid var(--holiday-bd);">
            <div style="max-width:1220px;margin:0 auto;padding:9px 24px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:13px;color:var(--holiday);">
                <span style="display:inline-flex;align-items:center;gap:7px;font-weight:600;">
                    <Icon Name="info" Size="15" /> Verify your email to keep access — @_verifyDaysLeft day@(_verifyDaysLeft == 1 ? "" : "s") left.
                </span>
                <a href="Account/VerifyEmail" style="margin-left:auto;color:var(--holiday);font-weight:700;text-decoration:underline;">Verify now</a>
            </div>
        </div>
    }

    <main style="max-width:1220px;width:100%;margin:0 auto;padding:26px 24px 50px;">
        @Body
    </main>

    @* The layout renders static SSR (interactivity is per-page), so the host
       must be its own interactive island to share the circuit's scoped
       IToastService with the pages that raise toasts. *@
    <ToastHost @rendermode="InteractiveServer" />
</div>

@code {
    private record NavItem(string Href, string Label, string Icon);

    private static readonly NavItem[] Items =
    [
        new("", "Timesheet", "clock"),
        new("calendar", "Calendar", "calendar"),
        new("jobs", "Jobs", "briefcase"),
        new("export", "Export", "download"),
        new("profile", "Profile", "user"),
    ];

    private string _displayName = "";
    private bool _showVerifyBanner;
    private int _verifyDaysLeft;
    private string Initials => string.Concat(
        _displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0]));

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        if (AuthState is not null && (await AuthState).User.Identity?.IsAuthenticated == true)
        {
            var user = await Data.CurrentUserAsync();
            _displayName = user.DisplayName;

            // Email-verification grace: unverified accounts may use the app for a
            // window, then are blocked until they verify. Within the window we show
            // a reminder banner; past it we bounce them to the verify page.
            if (!user.EmailConfirmed)
            {
                var now = DateTimeOffset.UtcNow;
                if (TimesheetTracker.Web.Services.AccountGrace.IsBlocked(false, user.CreatedAt, now))
                {
                    Nav.NavigateTo("Account/VerifyEmail", forceLoad: true);
                    return;
                }
                _verifyDaysLeft = TimesheetTracker.Web.Services.AccountGrace.DaysLeft(user.CreatedAt, now);
                _showVerifyBanner = true;
            }
        }
    }
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => StateHasChanged();
    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private bool IsActive(string href)
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
        var slash = path.IndexOf('/');
        if (slash >= 0) path = path[..slash];
        return string.Equals(path, href, StringComparison.OrdinalIgnoreCase);
    }
}
