@page "/Account/Manage/ChangePassword"

@using System.ComponentModel.DataAnnotations

@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Change password · Timesheet Tracker</PageTitle>

<PageHead Title="Change password" Subtitle="Update the password for your account." />

<div style="max-width:480px;padding:22px 0 40px;">
    <Card Title="Password">
        @if (_message is not null)
        {
            <div style="margin-bottom:14px;padding:10px 12px;border-radius:var(--r-sm);font-size:13px;
                        background:@(_success ? "var(--accent-tint)" : "var(--danger-tint)");
                        color:@(_success ? "var(--accent-text)" : "var(--danger)");">@_message</div>
        }
        <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <div style="display:flex;flex-direction:column;gap:14px;">
                <label style="display:flex;flex-direction:column;gap:6px;">
                    <span style="font-size:12.5px;font-weight:600;color:var(--text-soft);">Current password</span>
                    <InputText type="password" @bind-Value="Input.OldPassword" class="input" autocomplete="current-password" />
                    <ValidationMessage For="() => Input.OldPassword" style="font-size:12px;color:var(--danger);" />
                </label>
                <label style="display:flex;flex-direction:column;gap:6px;">
                    <span style="font-size:12.5px;font-weight:600;color:var(--text-soft);">New password</span>
                    <InputText type="password" @bind-Value="Input.NewPassword" class="input" autocomplete="new-password" placeholder="At least 12 characters" />
                    <ValidationMessage For="() => Input.NewPassword" style="font-size:12px;color:var(--danger);" />
                </label>
                <label style="display:flex;flex-direction:column;gap:6px;">
                    <span style="font-size:12.5px;font-weight:600;color:var(--text-soft);">Confirm new password</span>
                    <InputText type="password" @bind-Value="Input.ConfirmPassword" class="input" autocomplete="new-password" />
                    <ValidationMessage For="() => Input.ConfirmPassword" style="font-size:12px;color:var(--danger);" />
                </label>
                <div style="display:flex;gap:8px;">
                    <Btn Variant="primary" Style="height:42px;">Update password</Btn>
                    <Btn Variant="outline" Href="profile" Style="height:42px;">Back</Btn>
                </div>
            </div>
        </EditForm>
    </Card>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private InputModel Input { get; set; } = default!;

    private string? _message;
    private bool _success;

    protected override void OnInitialized() => Input ??= new();

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectTo("Account/Login");
            return;
        }

        if (!await UserManager.HasPasswordAsync(user))
        {
            _message = "This account signs in with Google and has no password to change.";
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            _message = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        Input = new();
        _message = "Your password has been changed.";
        _success = true;
    }

    private sealed class InputModel
    {
        [Required, DataType(DataType.Password)]
        public string OldPassword { get; set; } = "";

        [Required, StringLength(100, MinimumLength = 12, ErrorMessage = "Password must be at least 12 characters.")]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
