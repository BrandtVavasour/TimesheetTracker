@page "/Account/AccountDeleted"

<PageTitle>Account deleted · Timesheet Tracker</PageTitle>

<AuthShell Title="Your account has been deleted"
           Subtitle="Your profile and all of your jobs and time entries have been permanently removed. Thanks for using Timesheet Tracker.">
    <a href="Account/Register" class="ts-btn focusable" data-variant="primary"
       style="display:inline-flex;align-items:center;justify-content:center;width:100%;height:42px;font-size:15px;font-weight:600;border-radius:var(--r-sm);text-decoration:none;border:1px solid transparent;background:var(--accent);color:#fff;box-shadow:var(--sh-1);">
        Create a new account
    </a>
</AuthShell>
